{
    "name": "Programmering 1 - C# .NET 10",
    "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "streetsidesoftware.code-spell-checker"
